<?xml version="1.0" encoding="utf-8"?>
<!-- Icône de l'appli : l'image (docs/icone-source.webp) couvre toute la surface, Android la découpe à la forme du téléphone. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/window_bg" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <!-- Version à une couleur, pour les icônes « à thème » d'Android 13 et plus. -->
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
